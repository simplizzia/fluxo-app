# =============================================================================
# Fluxo App — Variáveis de Ambiente
# Copie para .env.local e preencha os valores reais.
# NUNCA commite .env.local no Git.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (obrigatório)
# Encontre em: supabase.com → projeto → Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role — NUNCA expor no frontend, somente server-side
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Anthropic Claude API (obrigatório para Izzi, agentes e relatórios)
# Encontre em: console.anthropic.com → API Keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# Modelo padrão para chamadas da aplicação
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Resend (obrigatório para emails)
# Encontre em: resend.com → API Keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...

# Remetente dos emails (deve estar verificado no Resend)
RESEND_FROM_EMAIL=izzi@simplizzia.com.br
RESEND_FROM_NAME=Izzi da Simplizzia

# ---------------------------------------------------------------------------
# Google Calendar (opcional — habilita integração OAuth2 para reuniões)
# Console: console.cloud.google.com → APIs & Services → Credentials
# Ativar: "Google Calendar API" no projeto
# Criar credencial: OAuth 2.0 Client ID → Aplicativo Web
# URI de redirecionamento autorizado:
#   http://localhost:3000/api/auth/google/callback        (desenvolvimento)
#   https://app.simplizzia.com.br/api/auth/google/callback (produção)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Em produção:
# NEXT_PUBLIC_APP_URL=https://app.simplizzia.com.br

# ID da organização Simplizzia (criado no seed)
NEXT_PUBLIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# ---------------------------------------------------------------------------
# Cron jobs (Vercel)
# ---------------------------------------------------------------------------
CRON_SECRET=seu_token_secreto_aqui

# ---------------------------------------------------------------------------
# Meta / Facebook (Sprint 5.4 — Redes Sociais)
# App criado em developers.facebook.com, permissões: pages_manage_posts, pages_read_engagement
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ENABLED=true

# ---------------------------------------------------------------------------
# LinkedIn (Sprint 5.4 — Redes Sociais)
# App em linkedin.com/developers, escopos: w_member_social, r_organization_social
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ENABLED=true

# ---------------------------------------------------------------------------
# WhatsApp (Sprint 5.6 — inbound webhook + outbound notifications)
# Provider: evolution | twilio
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=evolution

# Evolution API (https://evolution-api.com)
WHATSAPP_API_URL=https://evo.sua-empresa.com
WHATSAPP_API_TOKEN=seu_apikey_evolution
WHATSAPP_PHONE_NUMBER_ID=nome-da-instancia

# Twilio (alternativa)
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_API_TOKEN=seu_auth_token_twilio
# WHATSAPP_PHONE_NUMBER_ID=+5511999999999

# Secret para validar o webhook inbound do WhatsApp
WHATSAPP_WEBHOOK_SECRET=seu_secret_aqui

# ---------------------------------------------------------------------------
# OpenAI Whisper (Sprint 5.3 — transcrição de áudio, fallback)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# URL do site de onboarding de parceiros (publicado em onboarding.simplizzia.com.br)
NEXT_PUBLIC_ONBOARDING_URL=https://onboarding.simplizzia.com.br

# ---------------------------------------------------------------------------
# Supabase Storage (buckets criados via migration ou dashboard)
# ---------------------------------------------------------------------------
# Buckets: content-files | contracts | brand-assets | report-exports | moodboard-assets | socias-docs | social-media | avisos
# Configuração feita no dashboard do Supabase, não via env.
