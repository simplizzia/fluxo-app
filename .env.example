# =============================================================================
# Fluxo App — Variáveis de Ambiente
# Copie para .env.local e preencha os valores reais.
# NUNCA commite .env.local no Git.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (obrigatório)
# Encontre em: supabase.com → projeto → Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role — NUNCA expor no frontend, somente server-side
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Anthropic Claude API (obrigatório para Izzi, agentes e relatórios)
# Encontre em: console.anthropic.com → API Keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# Modelo padrão para chamadas da aplicação
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Resend (obrigatório para emails)
# Encontre em: resend.com → API Keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...

# Remetente dos emails (deve estar verificado no Resend)
RESEND_FROM_EMAIL=izzi@simplizzia.com.br
RESEND_FROM_NAME=Izzi da Simplizzia

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Em produção:
# NEXT_PUBLIC_APP_URL=https://app.simplizzia.com.br

# ID da organização Simplizzia (criado no seed)
NEXT_PUBLIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# ---------------------------------------------------------------------------
# Supabase Storage (buckets criados via migration ou dashboard)
# ---------------------------------------------------------------------------
# Buckets: content-files | contracts | brand-assets | report-exports | moodboard-assets | socias-docs
# Configuração feita no dashboard do Supabase, não via env.
