# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example é o único que deve ser commitado
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# entregáveis de cliente e saídas de agente — permanecem em disco, fora do git.
# 70 MB de .md/.xlsx/imagens que não são código da aplicação.
/clientes
/scripts/outputs-*.json

# pacote genérico de skills do superpowers — metodologia, sem conteúdo do projeto
/.agents
/skills-lock.json

# estado local de sessão do Claude Code (launch.json é versionado)
/.claude/scheduled_tasks.lock
/.claude/skills

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# cache local do Supabase CLI — recriado por `supabase link`
/supabase/.temp
